DATABASE_URL=mysql+pymysql://signer:CHANGE_ME@mysql.example.internal:3306/apple_remote_sign?charset=utf8mb4
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_IO_TIMEOUT_SECONDS=30
DATABASE_POOL_TIMEOUT_SECONDS=10
# Shared coordination for every replica. /3 selects logical DB 3; omit it for DB 0.
# Use rediss:// for TLS; percent-encode special characters in credentials.
REDIS_URL=redis://:CHANGE_ME@redis.example.internal:6379/3
# Keep the platform termination grace period larger than this plus preStop time.
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=3700
APPLE_KEY_FILE=/run/secrets/apple-api-key.json

OIDC_ISSUER_URL=https://identity.example.com/realms/team
OIDC_CLIENT_ID=apple-remote-sign
OIDC_CLIENT_SECRET=REPLACE_WITH_YOUR_CLIENT_SECRET
OIDC_REDIRECT_URI=https://api.sign.example.com/api/v1/auth/callback
OIDC_USERNAME_CLAIM=preferred_username
OIDC_SCOPES="openid profile"
OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
# JSON arrays, usernames match exactly. Administrators always may log in.
OIDC_ADMIN_USERNAMES=["admin"]
OIDC_ALLOWED_USERNAMES=[]
FRONTEND_URL=https://sign.example.com
CORS_ALLOWED_ORIGINS=[]
# Leave COOKIE_DOMAIN unset for a host-only cookie (recommended).
# COOKIE_DOMAIN=example.com
COOKIE_NAME=ars_session
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=28800
OIDC_LOGIN_TTL_SECONDS=600
OIDC_TIMEOUT_SECONDS=15

DATA_DIR=/data
SIGNING_CERTIFICATE_FILE=/run/secrets/signing.p12
SIGNING_PASSWORD_FILE=/run/secrets/signing-password
RCODESIGN_BIN=/usr/local/bin/rcodesign
RCODESIGN_WORK_DIR=/app
# Optional signing-only TOML; notary-submit and staple always ignore config files.
# RCODESIGN_CONFIG_FILE=/run/secrets/signing.toml

COMMAND_TIMEOUT_SECONDS=1800
STAPLE_TIMEOUT_SECONDS=120
APPLE_TIMEOUT_SECONDS=30
MAX_UPLOAD_BYTES=2147483648
MAX_EXTRACTED_BYTES=4294967296
MAX_ARCHIVE_ENTRIES=100000

# Final artifacts are uploaded to S3 before a job becomes completed.
# Keys: <S3_PREFIX><application_id>/yyyy/mm/dd/<job_id>/<filename> (UTC creation date).
S3_BUCKET=signing-artifacts
S3_PREFIX=app-dist/
# Optional S3-compatible endpoint (AWS S3 uses its regional endpoint by default).
# S3_ENDPOINT_URL=https://s3.example.com
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=auto
S3_CONNECT_TIMEOUT_SECONDS=10
S3_READ_TIMEOUT_SECONDS=60
# Optional explicit credentials; leave unset to use the SDK credential chain / IAM role.
# AWS_ACCESS_KEY_ID=REPLACE_WITH_YOUR_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=REPLACE_WITH_YOUR_SECRET_ACCESS_KEY
# AWS_SESSION_TOKEN=REPLACE_WITH_YOUR_SESSION_TOKEN

# CDN origin maps directly to the S3 bucket root. Validity is configured on the CDN.
CDN_BASE_URL=https://download.example.com
CDN_SIGN_KEY=REPLACE_WITH_YOUR_EDGEONE_TYPE_A_KEY
CDN_SIGN_PARAM=eo_sign

# Optional WeCom group robot notifications. Empty disables notifications.
WECOM_WEBHOOK_URL=
WECOM_TIMEOUT_SECONDS=5

# Tracing is always enabled. With no endpoint, spans are discarded locally; trace IDs remain.
OTEL_SERVICE_NAME=apple-remote-sign
# OTLP/gRPC target, e.g. http://collector:4317 (plaintext) or https://collector:4317 (TLS).
# No /v1/traces path is appended.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional traces target, taking precedence over the general endpoint.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Optional resource attributes, e.g. token=... for Tencent APM.
# OTEL_RESOURCE_ATTRIBUTES=token=REPLACE_WITH_YOUR_APM_TOKEN
